  {
    "id": "fn_process_telemetry",
    "type": "function",
    "z": "tab_transformer_monitor",
    "name": "Extract & Evaluate Health",
    "func": "var data = msg.payload;\n\n// Gauge payloads\nvar msg_winding = { payload: data.winding_temperature, topic: 'Winding Temp (°C)' };\nvar msg_oil = { payload: data.oil_temperature, topic: 'Oil Temp (°C)' };\nvar msg_vib = { payload: data.vibration_rms, topic: 'Vibration RMS (g)' };\nvar msg_curr = { payload: data.load_current, topic: 'Load Current (A)' };\n\n// Local threshold alert logic\nvar alerts = [];\nif (data.winding_temperature > 95.0) {\n    alerts.push('CRITICAL: Winding Overheating (' + data.winding_temperature + '°C)');\n}\nif (data.oil_temperature > 85.0) {\n    alerts.push('WARNING: Elevated Oil Temperature (' + data.oil_temperature + '°C)');\n}\nif (data.vibration_rms > 1.10) {\n    alerts.push('CRITICAL: Severe Vibration Fault (' + data.vibration_rms + 'g)');\n}\nif (data.load_current > 105.0) {\n    alerts.push('WARNING: Current Overload (' + data.load_current + 'A)');\n}\n\nvar msg_alert = null;\nif (alerts.length > 0) {\n    msg_alert = {\n        payload: alerts.join(' | '),\n        severity: 'Critical',\n        timestamp: data.timestamp\n    };\n}\n\nreturn [msg_winding, msg_oil, msg_vib, msg_curr, msg_alert];",
    "outputs": 5,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 430,
    "y": 180,
    "wires": [
      ["node_gauge_winding"],
      ["node_gauge_oil"],
      ["node_gauge_vib"],
      ["node_gauge_current"],
      ["node_alert_output"]
    ]
  },
